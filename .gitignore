/cache/
/logs/
/tmp/
/backup/
/vendor/

# Кеш обработанных изображений Grav — только в корне.
# Раньше правило было без ведущего слэша и срабатывало на любом уровне
# вложенности: под него попала user/plugins/admin/themes/grav/images/,
# её никогда не коммитили, и админка падала с 500 на @admin-images.
/images/

.env
.idea/
.vscode/
.DS_Store
Thumbs.db

/user/plugins/online-order-fs/orders/

# Боевые оверрайды с секретами инстансов МИС
/user/config/plugins/checkvkk.yaml
/user/config/plugins/online-order-fs.yaml

# Соль Grav: ею подписываются токены форм и сессий. В репозитории ей не место.
# Второе правило — та же соль для окружений (user/localhost/config, user/<env>/config).
/user/config/security.yaml
/user/*/config/security.yaml

# Генерится админкой из настроек White Label (AdminController::taskSaveWhiteLabel,
# см. user/plugins/admin/classes/plugin/AdminController.php). Не исходник.
/assets/admin-preset.css

# Индексы Flex — производный кеш, Grav переписывает их на каждом заходе в админку.
# В репозитории они не нужны, а вред приносили: после git pull файлы получали
# группу деплойного юзера, php-fpm терял на них запись, и админка падала с
# «Opening file for writing failed ... Permission denied» на Admin::__construct.
/user/data/flex/indexes/

# Прочее рантайм-состояние Grav в user/data: кеш GPM-фида, состояние планировщика,
# прочитанные уведомления админки, стейджи обновлений. Прод переписывает их сам,
# в репозитории они только конфликтуют с каждым pull.
# licenses.yaml намеренно оставлен в git — там ключи премиум-плагинов.
/user/data/feed/
/user/data/notifications/
/user/data/scheduler/
/user/data/upgrades/

# Карантин для выведенных из работы файлов (правило проекта: не удалять, а переносить сюда).
# Может содержать ПДн — в репозиторий не попадает никогда.
/_deadcode/

# Скриншоты и прочие картинки, брошенные в корень проекта.
# Контентные изображения лежат в user/pages, user/blog, user/themes — их не затрагивает.
/*.jpg
/*.jpeg
/*.png
/*.webp
/*.gif
/*.bmp
/*.heic
/screen.*

# Артефакт перенаправления вывода в Windows (`... > nul`)
/nul
/NUL
