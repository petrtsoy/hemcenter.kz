{# Скрипты в конце <body>. Файл перекрывает partials/scripts.html.twig из
   bootstrap4-open-matter (там пустая заглушка) — см. streams в hemcenter.yaml.

   Яндекс.Метрика: номер счётчика берётся из hemcenter.yaml
   (analytics.yandex_metrika_id), пустое значение — счётчик не подключается.
   На локальных доменах счётчик не подключается, чтобы разработка не попадала
   в статистику. #}

{% set ym_id = theme_var('analytics.yandex_metrika_id')|default('')|trim %}
{% set ym_host = grav.uri.host|default('') %}
{% set ym_is_dev = ym_host in ['localhost', '127.0.0.1', '::1'] or ym_host ends with '.local' or ym_host ends with '.test' %}

{% if ym_id matches '/^[0-9]+$/' and not ym_is_dev %}
<!-- Yandex.Metrika counter -->
<script>
(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
m[i].l=1*new Date();
for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
(window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");

ym({{ ym_id }}, "init", {
    clickmap: true,
    trackLinks: true,
    accurateTrackBounce: true,
    webvisor: {{ theme_var('analytics.webvisor') ? 'true' : 'false' }}
});
</script>
<noscript><div><img src="https://mc.yandex.ru/watch/{{ ym_id }}" style="position:absolute; left:-9999px;" alt=""></div></noscript>
<!-- /Yandex.Metrika counter -->
{% endif %}
