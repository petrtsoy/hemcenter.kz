{% extends 'partials/base.html.twig' %}

{% block content %}
    <div class="page-body">
        <div class="shell measure">
            <p class="eyebrow">{{ page.header.http_response_code ?: 404 }}</p>
            <h1 class="page-title" style="margin-top:1rem">{{ page.title }}</h1>
            <hr class="title-rule">
            <div class="prose">{{ page.content|raw }}</div>
            <p style="margin-top:2.5rem"><a href="{{ base_url ?: '/' }}">← {{ 'THEME.SITE_NAME'|t }}</a></p>
        </div>
    </div>
{% endblock %}
